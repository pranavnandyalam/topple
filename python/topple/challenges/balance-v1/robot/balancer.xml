<!--
  Topple placeholder balancer (balancer.robot.v1). Body tree only: the scene owns physics options,
  and topple.robot.build_model injects motors and IMU sensors from params.yaml.
  Frames: chassis origin at the axle midpoint; x forward, y left, z up.
-->
<mujoco model="balancer">
  <compiler angle="radian" autolimits="true"/>
  <worldbody>
    <body name="chassis" pos="0 0 0.034">
      <freejoint name="root"/>
      <inertial pos="0 0 0.08" mass="0.45" diaginertia="0.001335 0.001095 0.00051"/>
      <geom name="chassis_box" type="box" size="0.03 0.05 0.08" pos="0 0 0.08" density="0"
            rgba="0.16 0.42 0.86 1"/>
      <geom name="battery" type="box" size="0.022 0.04 0.012" pos="0 0 0.115" density="0"
            contype="0" conaffinity="0" rgba="0.12 0.12 0.14 1"/>
      <site name="imu" pos="0 0 0.10" size="0.006" rgba="1 0.8 0 1"/>
      <site name="push_point" pos="0 0 0.08" size="0.006" rgba="1 0.2 0.2 1"/>
      <body name="left_wheel_body" pos="0 0.07 0">
        <joint name="left_wheel" type="hinge" axis="0 1 0"/>
        <geom name="left_tire" type="cylinder" size="0.034 0.013" zaxis="0 1 0" mass="0.04"
              rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel_body" pos="0 -0.07 0">
        <joint name="right_wheel" type="hinge" axis="0 1 0"/>
        <geom name="right_tire" type="cylinder" size="0.034 0.013" zaxis="0 1 0" mass="0.04"
              rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
